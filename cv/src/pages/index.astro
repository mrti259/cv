---
import '../assets/global.css';
import 'devicon/devicon.min.css';
import '../assets/icons/pin.css';
import '../assets/icons/mail.css';
import '../assets/icons/flag-alt.css';
import '../assets/icons/printer.css';
import '../assets/icons/arrows-exchange.css';
import '../assets/icons/pen.css';
import '../assets/icons/export.css';
import '../assets/icons/copy.css';
import App from '../components/app.svelte';
import dataEs from '../assets/es.yaml';
import dataEn from '../assets/en.yaml';

const base = import.meta.env.BASE_URL;
const canonical = Astro.site ? new URL(base, Astro.site).href : base;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href=`${base}/favicon.svg` />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Resume of Borja Garibotti, Full Stack Developer specialized in .NET, React Native and Flutter."
		/>
		<meta property="og:title" content="Borja Garibotti | Full Stack Developer" />
		<meta
			property="og:description"
			content="Resume of Borja Garibotti, Full Stack Developer specialized in .NET, React Native and Flutter."
		/>
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta name="generator" content={Astro.generator} />
		<base href={base} />
		<title>Borja Garibotti | Full Stack Developer</title>
	</head>
	<body>
		<App client:load dataList={[dataEn, dataEs]} />
	</body>
</html>
